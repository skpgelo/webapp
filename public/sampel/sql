    // ----------------------------------------------------
    // PROSES UPLOAD FOTO (DENGAN VALIDASI TEKS KETAT)
    // ----------------------------------------------------
    public function prosesFoto()
    {
        // alpha_numeric_punct: Hanya mengizinkan huruf, angka, spasi, dan tanda baca standar.
        // Menolak karakter ekstrim seperti tag HTML (<, >, /), backslash (\), dll.
        $rules = [
            'judul_image' => 'required|min_length[3]|max_length[100]|alpha_numeric_punct',
            'tema_image'  => 'required|min_length[3]|max_length[50]|alpha_numeric_punct',
            'foto_hp'     => 'uploaded[foto_hp]|mime_in[foto_hp,image/jpg,image/jpeg,image/png,image/webp,image/heic,image/heif]|max_size[foto_hp,15360]'
        ];

        // Kustom pesan error jika input teks mengandung karakter berbahaya
        $messages = [
            'judul_image' => [
                'alpha_numeric_punct' => 'Judul hanya boleh berisi huruf, angka, spasi, dan tanda baca standar. Karakter ilegal ditolak!'
            ],
            'tema_image' => [
                'alpha_numeric_punct' => 'Tema hanya boleh berisi huruf, angka, spasi, dan tanda baca standar. Karakter ilegal ditolak!'
            ]
        ];

        if (!$this->validate($rules, $messages)) {
            return redirect()->back()->withInput()->with('errors_foto', $this->validator->getErrors());
        }

        // SANITASI EKSTRA: Gunakan strip_tags untuk membersihkan jika ada sisa tag HTML/Skrip
        $judul = strip_tags($this->request->getPost('judul_image'));
        $tema  = strip_tags($this->request->getPost('tema_image'));
        $foto  = $this->request->getFile('foto_hp');

        if ($foto->isValid() && !$foto->hasMoved()) {
            $newNameFoto = $foto->getRandomName();
            $foto->move(FCPATH . 'uploads/', $newNameFoto);

            try {
                $this->dokumenModel->insertFotoRaw($judul, $tema, $newNameFoto);
                return redirect()->to('upload')->with('success_foto', 'Foto HP berhasil diarsipkan dengan aman!');
            } catch (\Exception $e) {
                if (file_exists(FCPATH . 'uploads/' . $newNameFoto)) unlink(FCPATH . 'uploads/' . $newNameFoto);
                return redirect()->back()->with('error_foto', 'Gagal simpan DB: ' . $e->getMessage());
            }
        }
    }

